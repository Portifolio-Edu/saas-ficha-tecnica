# Copie para .env.local. Nunca coloque segredos no Git ou em NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Dados públicos da empresa que fornece o SaaS (não do restaurante cliente).
# Variáveis NEXT_PUBLIC_ exigem novo build após alterações.
NEXT_PUBLIC_EMPRESA_RAZAO_SOCIAL=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_EMPRESA_ENDERECO=
NEXT_PUBLIC_EMPRESA_EMAIL_CONTATO=
NEXT_PUBLIC_EMPRESA_EMAIL_PRIVACIDADE=
NEXT_PUBLIC_EMPRESA_FORO=

# Cobrança desligada até validar migration, webhook e ciclo completo em sandbox.
ASAAS_COBRANCA_HABILITADA=false
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Preço inteiro em centavos, escolhido pelo responsável pelo produto.
ASAAS_PLANO_MENSAL_CENTAVOS=

# Integrações opcionais já existentes. Segredos diferentes, >= 32 caracteres.
AGENTE_SEGREDO=
AGENTE_CHAVE_N8N=
AGENTE_N8N_URL=
AGENTE_WHATSAPP_NUMERO=
